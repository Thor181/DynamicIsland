<Window x:Class="DynamicIsland.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="440" Height="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="PrimaryText" Color="#FFF2F2F7" />
        <SolidColorBrush x:Key="SecondaryText" Color="#FF98989F" />
        <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF2C2C2E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF30D158" />

        <Style x:Key="Panel" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS-style battery glyph -->
        <DataTemplate x:Key="BatteryGlyph">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="26" Height="13">
                    <Border BorderBrush="#88FFFFFF" BorderThickness="1.2" CornerRadius="3.5" />
                    <Border Background="{Binding BatteryBrush}" CornerRadius="2" Margin="2"
                            HorizontalAlignment="Left" Width="{Binding BatteryFillWidth}" />
                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="9"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsCharging, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <Border Width="2" Height="5" Background="#88FFFFFF" CornerRadius="0,1,1,0" Margin="1,0,0,0" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- The island is placed on the canvas in code-behind: its position depends on the anchor the
         user dragged it to and on its current size (it's kept inside the screen's work area). -->
    <Canvas>
        <Border x:Name="Island"
                Width="160" Height="36" CornerRadius="18" Background="Black"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" MouseWheel="Island_MouseWheel"
                MouseLeftButtonDown="Island_MouseLeftButtonDown" MouseMove="Island_MouseMove"
                MouseLeftButtonUp="Island_MouseLeftButtonUp" LostMouseCapture="Island_LostMouseCapture">
            <Grid>

                <!-- Animated background under the content. Which parts are used depends on the
                     effect chosen in settings; brushes and animations are built in code-behind.
                     BlobLayer coordinates are a fixed 400x164 space scaled to the island's current
                     size, so the same motion fits both the pill and the expanded island. A Canvas
                     doesn't clip; the island's rounded Clip trims everything. -->
                <Grid x:Name="EffectLayer" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                    <Canvas x:Name="BlobLayer" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Ellipse Width="300" Height="240" />
                        <Ellipse Width="280" Height="220" />
                        <Ellipse Width="260" Height="220" />
                    </Canvas>
                    <Border x:Name="FillLayer" />
                    <Border x:Name="RingLayer" />
                </Grid>

                <!-- Compact: clock -->
                <Grid x:Name="CompactClockPanel" Style="{StaticResource Panel}" Width="160" Height="36">
                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource PrimaryText}"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Compact: now playing -->
                <Grid x:Name="CompactMediaPanel" Style="{StaticResource Panel}" Width="250" Height="36">
                    <Grid Width="24" Height="24" HorizontalAlignment="Left" Margin="7,0,0,0">
                        <Border CornerRadius="6" Background="{StaticResource SurfaceBrush}" />
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="Equalizer" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Height="16" Margin="0,0,14,0">
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5" />
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5" />
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5" />
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5" />
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" Fill="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5" />
                    </StackPanel>
                </Grid>

                <!-- Expanded: clock + date + battery -->
                <Grid x:Name="ExpandedClockPanel" Style="{StaticResource Panel}" Width="320" Height="96">
                    <StackPanel VerticalAlignment="Center" Margin="26,0,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource PrimaryText}"
                                   FontSize="34" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DateText}" Foreground="{StaticResource SecondaryText}" FontSize="13" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,26,0"
                                Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BatteryPercent, StringFormat={}{0}%}" Foreground="{StaticResource PrimaryText}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BatteryGlyph}" />
                    </StackPanel>
                </Grid>

                <!-- Expanded: media player -->
                <Grid x:Name="ExpandedMediaPanel" Style="{StaticResource Panel}" Width="400" Height="164">
                    <Grid Margin="22,20,22,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="54" Height="54">
                                <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}">
                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                               Foreground="{StaticResource SecondaryText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border CornerRadius="12">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MediaTitle}" Foreground="{StaticResource PrimaryText}"
                                           FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MediaArtist}" Foreground="{StaticResource SecondaryText}"
                                           FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PositionText}" Foreground="{StaticResource SecondaryText}" FontSize="11"
                                       VerticalAlignment="Center" />
                            <!-- Seek bar: the transparent grid is a taller hit area around the thin track. -->
                            <Grid x:Name="SeekBar" Grid.Column="1" Height="18" VerticalAlignment="Center"
                                  Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="SeekBar_MouseLeftButtonDown" MouseMove="SeekBar_MouseMove"
                                  MouseLeftButtonUp="SeekBar_MouseLeftButtonUp" LostMouseCapture="SeekBar_LostMouseCapture">
                                <Grid VerticalAlignment="Center">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Height" Value="5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=SeekBar}" Value="True">
                                                    <Setter Property="Height" Value="8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSeeking}" Value="True">
                                                    <Setter Property="Height" Value="8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border Background="{StaticResource TrackBrush}" CornerRadius="4" />
                                    <Border Background="{StaticResource PrimaryText}" CornerRadius="4" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Progress}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{StaticResource SecondaryText}"
                                       FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="{Binding PlayPauseGlyph}" FontSize="24"
                                    Command="{Binding PlayPauseCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Toast: volume / brightness level -->
                <Grid x:Name="LevelPanel" Style="{StaticResource Panel}" Width="320" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LevelGlyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" Margin="20,0,14,0" Width="20" />
                    <Grid Grid.Column="1" Height="6" VerticalAlignment="Center">
                        <Border Background="{StaticResource TrackBrush}" CornerRadius="3" />
                        <Border Background="{StaticResource PrimaryText}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding LevelValue}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding LevelText}" Foreground="{StaticResource PrimaryText}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"
                               MinWidth="34" Margin="12,0,20,0" />
                </Grid>

                <!-- Toast: battery -->
                <Grid x:Name="BatteryPanel" Style="{StaticResource Panel}" Width="320" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding BatteryMessage}" Foreground="{StaticResource PrimaryText}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="22,0,0,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                        <TextBlock Text="{Binding BatteryPercent, StringFormat={}{0}%}" Foreground="{Binding BatteryBrush}"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BatteryGlyph}" />
                    </StackPanel>
                </Grid>

                <!-- Toast: notification -->
                <Grid x:Name="NotificationPanel" Style="{StaticResource Panel}" Width="390" Height="84"
                      MouseLeftButtonUp="NotificationPanel_Click" Cursor="Hand" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                            Margin="18,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7E7;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{StaticResource PrimaryText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,22,0">
                        <TextBlock Text="{Binding NotificationApp}" Foreground="{StaticResource SecondaryText}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding NotificationTitle}" Foreground="{StaticResource PrimaryText}"
                                   FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding NotificationBody}" Foreground="{StaticResource SecondaryText}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Canvas>
</Window>
